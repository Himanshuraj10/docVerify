APP_ENV=production
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/document_verification
SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

OWNER_EMAIL=owner@yourdomain.com
OWNER_NAME=Platform Owner
OWNER_INITIAL_PASSWORD=replace-with-a-strong-production-password

BLOCKCHAIN_RPC_URL=https://your-rpc-endpoint
BLOCKCHAIN_PRIVATE_KEY=your-production-private-key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

OCR_ENGINE=rapidocr
FRONTEND_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
